<Window x:Class="SmokeApp.TransparentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmokeApp transparent" Width="360" Height="240"
        WindowStartupLocation="Manual" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <!-- Layered window (UpdateLayeredWindow present path): per-pixel alpha must survive the
       GPU-to-GDI hand-off. Left half is a translucent rounded panel, right half fades to
       fully transparent, the bottom strip is 40% black over nothing. -->
  <Grid>
    <Border Margin="16,16,150,56" CornerRadius="24" Background="#9930A0E0" BorderBrush="White" BorderThickness="3">
      <TextBlock Text="Transparent" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Ellipse Width="150" Height="150" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#FFFFA030" Offset="0"/>
          <GradientStop Color="#80FF4040" Offset="0.6"/>
          <GradientStop Color="#00FF4040" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Rectangle Height="32" VerticalAlignment="Bottom" Margin="16,0,16,12" Fill="#66000000" RadiusX="8" RadiusY="8"/>
    <TextBlock Text="alpha 0.4 strip" Foreground="#FFE0E0E0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
  </Grid>
</Window>
